# Copy to config.env and edit if needed:
#   cp config.example.env config.env
#
# Do NOT commit config.env or .discord_webhook to star-analyzer_backup.git

SRC="/gpfs01/star/pwg/rjsaito/star-analyzer"
DEST="/gpfs01/star/pwg/rjsaito/backup/star-analyzer"
GITHUB_REMOTE="git@github.com:rjsaito0519/star-analyzer_backup.git"
GITHUB_BRANCH="main"
STATE_DIR="$HOME/.config/star-analyzer-backup"
BACKUP_SCRIPT="$SRC/mytool/star_analyzer_backup/backup.sh"
PUSH_SCRIPT="$SRC/mytool/star_analyzer_backup/push_backup.sh"
# Backup-only webhook (NOT the repo-root mysubmit .discord_webhook)
DISCORD_WEBHOOK_FILE="$SRC/mytool/star_analyzer_backup/.discord_webhook"
